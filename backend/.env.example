# Safe local-development placeholders only. Copy to .env and replace locally.
APP_ENV=development
BACKEND_CODE_VERSION=0.1.0-be1.1
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# --- Database ---------------------------------------------------------------
# POSTGRES_* are read ONLY by the `db` container in compose.yaml. They are ignored entirely when
# DATABASE_URL points at a hosted database, and can be left as-is in that case.
POSTGRES_DB=studentapp
POSTGRES_USER=studentapp
POSTGRES_PASSWORD=replace-with-a-local-secret

# Option A -- local Postgres in Docker (the default; `db` is the compose service name, which only
# resolves inside that network).
DATABASE_URL=postgresql://studentapp:replace-with-a-local-secret@db:5432/studentapp

# Option B -- hosted Postgres (Supabase or equivalent). Paste the provider's connection string
# verbatim; `sslmode` and the transaction-pooler prepared-statement problem are both handled for
# you in app/infrastructure/database.py, so nothing needs hand-editing out of it.
#
#   Direct connection (port 5432) -- simplest, but on Supabase this hostname is IPv6-only unless
#   the project has the IPv4 add-on:
# DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require
#
#   Transaction pooler (port 6543) -- IPv4, and what to use if the direct host will not resolve:
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@YOUR-REGION.pooler.supabase.com:6543/postgres?sslmode=require
#
# WARNING: never point this at a database holding real data while running the test suite. Six
# migration-reversibility tests drop and recreate EVERY table, empty. Use a separate database (or
# a second project) for tests -- see README "Running the tests safely".
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300
