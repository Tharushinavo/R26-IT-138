# Local development only. Gitignored (.gitignore:2). Never commit.
#
# Only the Supabase JWT-verification settings are set here; every other variable
# in compose.yaml falls through to its documented default, so the existing
# postgres volume (initialised with the default credentials) keeps working.
#
# NONE of these four values is a secret. The backend only VERIFIES tokens using
# Supabase's PUBLIC JWKS keys - it never needs the service-role key or the anon
# key. All four derive from the project ref alone.
APP_ENV=development

# PORT NOTE, corrected 2026-08-27. The previous note here said 8000 was unusable and
# 8200 worked. That has now inverted, and the reason matters more than either number:
# the Windows Hyper-V/WinNAT reserved ranges are DYNAMIC and move between reboots.
# Today `netsh interface ipv4 show excludedportrange protocol=tcp` reports 8190-8289
# reserved, which swallowed 8200 -- Docker failed with "An attempt was made to access
# a socket in a way forbidden by its access permissions", the same symptom 8000 gave
# before. 8000 is currently outside every reserved range, and is what .env.example and
# the README already use, so the two now agree.
#
# If this breaks again, re-run that netsh command rather than guessing: the range will
# have moved again. `net stop winnat && net start winnat` (as admin) releases the
# reservations, but Windows may re-take them on the next reboot.
#
# frontend/.env.local's EXPO_PUBLIC_API_BASE_URL is kept in step with this value.
API_PORT=8000

# The browser logs from 2026-08-24 in Dev/.playwright-mcp show the previous attempt
# to reach a Component C surface dying here, on /welcome:
#   Access to fetch at 'http://localhost:8200/api/v1/learner/profile' from origin
#   'http://localhost:8300' has been blocked by CORS policy
# Metro was on 8300; compose.yaml's default allows only 3000 and 8081. config.py:34
# splits this on commas and matches exactly - no wildcards - so every Metro port
# that will be used has to be named. 8081 is expo's default, 8300 is what was
# actually used last time.
# Component 3's teacher dashboard also calls this service (join requests and
# teacher-profile creation), so its dev origins are listed too: Vite's default
# 5173, plus the 127.0.0.1:5273 fallback used when 5173 is unavailable.
# 127.0.0.1 and localhost are DISTINCT origins here - no wildcards, exact match.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:8300,http://localhost:5173,http://127.0.0.1:5273,http://127.0.0.1:4173,http://localhost:4173

# --- Database -----------------------------------------------------------------
# Currently UNSET, so compose.yaml's default applies and all gameplay is written to
# the local Docker Postgres:
#     postgresql://upadya:local-development-only@db:5432/upadya
#
# To move the data to Supabase instead, uncomment ONE line below and replace
# YOUR-DB-PASSWORD with the database password from
#   Supabase dashboard -> Project Settings -> Database
# (that is the DB password, NOT the anon/service-role key, and NOT the JWKS values
# below -- those are public and cannot be used to connect).
#
# Paste it as-is: `sslmode=require` and the transaction-pooler prepared-statement
# problem are both handled in app/infrastructure/database.py. Nothing needs editing
# out of the string.
#
#   MEASURED 2026-08-27, so nobody has to rediscover it:
#     * The direct host `db.hliyqkmmghheoxvdxjbv.supabase.co` resolves IPv6-ONLY. The Docker
#       container has no IPv6 route, so it is unreachable from here. Use the pooler line below.
#     * This project's pooler region is `ap-southeast-1`. Established by elimination: every other
#       region answers "tenant/user not found", while aws-0-ap-southeast-1 answers
#       "password authentication failed" -- i.e. it is the only one that knows this tenant.
#     * PASSWORD: must be percent-encoded. An `@` becomes %40 (`Yasindu@2026` -> `Yasindu%402026`),
#       otherwise the URL parser reads the text before `@` as the username. Note the password
#       tried on 2026-08-27 was REJECTED by Supabase -- reset it in the dashboard
#       (Project Settings -> Database -> Reset database password) and encode the new one.
#
#   Direct connection -- unusable here (IPv6-only), kept for reference:
# DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.hliyqkmmghheoxvdxjbv.supabase.co:5432/postgres?sslmode=require
#
#   SESSION pooler, port 5432 -- VERIFIED WORKING 2026-08-27. This is the live line.
#
#   Port matters more than the password here, and this cost three password resets to find:
#   the TRANSACTION pooler (port 6543) rejects these credentials with
#   "password authentication failed", while the SESSION pooler (port 5432) on the SAME host,
#   same user, same password, connects fine. Three different passwords were all rejected on
#   6543 before the port turned out to be the variable. If authentication fails here, try the
#   other port before assuming the password is wrong.
#
#   Session mode is also the better fit: it imposes no prepared-statement restrictions, so
#   asyncpg runs with full Postgres semantics.
DATABASE_URL=postgresql://postgres.hliyqkmmghheoxvdxjbv:SLpredetor2027@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# After uncommenting, run once (see README "First run" steps 3-5):
#   docker compose run --rm api alembic upgrade head
#   docker compose run --rm api python -m scripts.register_c_runtime_bundle
#   docker compose up -d --force-recreate api
#
# WARNING: while DATABASE_URL points at Supabase, do NOT run the test suite. Six
# migration-reversibility tests drop and recreate every table, including the runtime
# bundle row registered above, and there is no local volume to restore from.

SUPABASE_URL=https://hliyqkmmghheoxvdxjbv.supabase.co
SUPABASE_JWT_ISSUER=https://hliyqkmmghheoxvdxjbv.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://hliyqkmmghheoxvdxjbv.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_CACHE_TTL_SECONDS=300