EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_APP_ENV=development
# Optional and development-only: new-session, readiness-failure, network-failure-once, or
# access-denied. Leave unset for the real FastAPI API.
# EXPO_PUBLIC_COMPONENT_B_DEV_FIXTURE=new-session

# Which language the learner reads questions in: en (default) or si.
# The Sinhala wording is a FIRST DRAFT and has not been reviewed by a Sinhala-speaking
# primary teacher -- leave this unset or 'en' until it has. See src/config/locale.ts.
EXPO_PUBLIC_LEARNER_LOCALE=en

# Component 3 (Learning Insight / teacher dashboard) base URL, for the teacher's "next step"
# message shown in the learner profile.
#
# OPTIONAL AND OFF BY DEFAULT. Leave it unset and the feature makes no request and shows no dot --
# which is correct while Component 3's GET /api/v1/t3/me/next-step does not exist. It is a
# DIFFERENT SERVICE from EXPO_PUBLIC_API_BASE_URL above; pointing it at our own backend would 404.
# EXPO_PUBLIC_T3_API_BASE_URL=http://localhost:8100
